rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidCurrency(curr) {
      return curr in ['INR', 'USD'];
    }

    function isValidCategory(cat) {
      return cat in [
        'Vegetables',
        'Chicken',
        'Beef',
        'Milk',
        'Gas',
        'Electricity',
        'Staff Wages',
        'Rent',
        'Maintenance',
        'Supermarket & Packaging',
        'Other Expenditure',
        'Daily Total Sales'
      ];
    }

    function isValidIsoDate(val) {
      return val is string && val.size() == 10 && val.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }

    function isValidTime24(val) {
      return val is string && val.size() == 5 && val.matches('^\\d{2}:\\d{2}$');
    }

    function isValidPositiveAmount(val) {
      return (val is int || val is float) && val > 0 && val <= 100000000;
    }

    function isValidUserAccount(data, userId) {
      return data.keys().hasAll(['userId', 'currency', 'monthlySavingsGoal', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'currency', 'monthlySavingsGoal', 'createdAt', 'updatedAt'])
        && isValidId(data.userId)
        && data.userId == userId
        && data.userId == request.auth.uid
        && isValidCurrency(data.currency)
        && (data.monthlySavingsGoal is int || data.monthlySavingsGoal is float)
        && data.monthlySavingsGoal >= 0
        && data.monthlySavingsGoal <= 100000000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTransaction(data, userId) {
      return data.keys().hasAll([
          'userId', 'title', 'amount', 'type', 'category',
          'date', 'time', 'notes', 'autoCategorized', 'sourceBillId',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId', 'title', 'amount', 'type', 'category',
          'date', 'time', 'notes', 'autoCategorized', 'sourceBillId',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.userId)
        && data.userId == userId
        && data.userId == request.auth.uid
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && isValidPositiveAmount(data.amount)
        && data.type in ['income', 'expense']
        && isValidCategory(data.category)
        && isValidIsoDate(data.date)
        && isValidTime24(data.time)
        && data.notes is string && data.notes.size() <= 300
        && data.autoCategorized is bool
        && data.sourceBillId is string && data.sourceBillId.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserAccount(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUserAccount(incoming(), userId)
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['currency', 'monthlySavingsGoal', 'updatedAt']);
      allow delete: if false;

      match /transactions/{transactionId} {
        allow get: if isValidId(userId) && isValidId(transactionId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(transactionId)
          && isOwner(userId)
          && isValidTransaction(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId)
          && isValidId(transactionId)
          && isOwner(userId)
          && isValidTransaction(incoming(), userId)
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'amount', 'type', 'category', 'date', 'time', 'notes', 'autoCategorized', 'updatedAt'
          ]);
        allow delete: if isValidId(userId) && isValidId(transactionId) && isOwner(userId);
      }
    }
  }
}
